{
	"name": "Jupyter AI Development Dev Container",
	"image": "siakhooi/devcontainer:jupyter312",
	"remoteUser": "maui",
	"containerUser": "maui",
	"updateRemoteUserUID": true,
	"features": {},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.makefile-tools",
				"mechatroner.rainbow-csv",
				"ms-python.python",
				"ms-python.debugpy",
				"ms-toolsai.jupyter-ai",
				"ms-toolsai.jupyter"
			]
		}
	},
	"mounts": [
	],
	"remoteEnv": {
		"LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
	}
}